# Supabase Postgres connection string. The only variable required in dev.
# Hosted project's Supavisor transaction pooler (port 6543, ?sslmode=require), in dev and prod.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Connection string drizzle-kit uses for migrations. Prod: the Supavisor session pooler (port 5432). Unset = DATABASE_URL.
DIRECT_URL=

# HMAC secret that signs the cs_session cookie. Required in production; dev fallback is used if unset.
SESSION_SECRET=
# Shared access code entered at /gate. Required in production; dev fallback is "dev-access".
ACCESS_CODE=
# Public base URL of the app, used to build fal webhook URLs. Required in production; dev fallback is http://localhost:3000.
APP_URL=
# Secret that signs per-candidate webhook tokens. Required in production; dev fallback is used if unset.
WEBHOOK_SECRET=
# Bearer token Vercel Cron sends to /api/cron/cleanup. Required in production; dev fallback is used if unset.
CRON_SECRET=

# fal.ai API key. Unset = mock image generation (dev only; required in production).
FAL_KEY=
# Anthropic API key. Unset = mock template analysis (dev only; required in production).
ANTHROPIC_API_KEY=
# Vercel Blob read/write token. Unset = uploads stored in public/uploads (dev only; required in production).
BLOB_READ_WRITE_TOKEN=

# Max generation rounds per day across all sessions (integer, default 150).
GLOBAL_DAILY_UNITS=150
# Days to keep uploads and results before the cleanup cron deletes them (integer, default 10).
RETENTION_DAYS=10
# Video templates (clips up to 15 s): true | false. Default false, which keeps the app photo-only.
VIDEO_ENABLED=false
# Face engine: auto (ONNX if models present, else mock) | onnx | mock. Default auto.
FACE_ENGINE=auto
# Mock fal failure injection for tests: none | once | always. Default none.
MOCK_FAL_FAILURE_MODE=none
